{
  "name": "@fintech/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "migrate:status": "pnpm run build && node --env-file-if-exists=../../.env dist/cli/migrate.js status",
    "migrate:up": "pnpm run build && node --env-file-if-exists=../../.env dist/cli/migrate.js up",
    "test": "vitest run --exclude \"tests/integration/**\"",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
